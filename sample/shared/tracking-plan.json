{
  "version": "1.0.0",
  "events": [
    {
      "name": "screen_view",
      "channel": "firebase",
      "description": "A screen of the shop, as it shows.",
      "schema": {
        "required": [
          "screen_name"
        ],
        "properties": {
          "screen_name": {
            "type": "string",
            "enum": [
              "catalog",
              "product",
              "cart",
              "payment",
              "confirmation"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "view_item_list",
      "channel": "firebase",
      "description": "The catalog, with every product on it.",
      "schema": {
        "required": [
          "item_list_name",
          "items"
        ],
        "properties": {
          "item_list_name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "item_name",
                "price",
                "index"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^SN-[0-9]+$"
                },
                "item_name": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "index": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "view_item",
      "channel": "firebase",
      "description": "A product's page.",
      "schema": {
        "required": [
          "currency",
          "value",
          "items"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "value": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "item_name",
                "price"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^SN-[0-9]+$"
                },
                "item_name": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "add_to_cart",
      "channel": "firebase",
      "description": "Add to cart, on a product's page.",
      "schema": {
        "required": [
          "currency",
          "value",
          "items"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "value": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "quantity"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^SN-[0-9]+$"
                },
                "quantity": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "begin_checkout",
      "channel": "firebase",
      "description": "Checkout, from the cart.",
      "schema": {
        "required": [
          "currency",
          "value",
          "items"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "value": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "quantity"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^SN-[0-9]+$"
                },
                "quantity": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "checkout_started",
      "channel": "gtm",
      "description": "The same checkout, server side.",
      "schema": {
        "required": [
          "cart_size"
        ],
        "properties": {
          "cart_size": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "purchase",
      "channel": "firebase",
      "description": "Pay, on the payment screen.",
      "schema": {
        "required": [
          "transaction_id",
          "currency",
          "value",
          "items"
        ],
        "properties": {
          "transaction_id": {
            "type": "string",
            "pattern": "^T-[0-9A-F]{6}$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "value": {
            "type": "number"
          },
          "user_email": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "quantity"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^SN-[0-9]+$"
                },
                "quantity": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "refund",
      "channel": "firebase",
      "description": "Planned, never sent by the sample: the plan screen shows it as not seen.",
      "schema": {
        "required": [
          "transaction_id"
        ],
        "properties": {
          "transaction_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
